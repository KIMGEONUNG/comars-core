#!/usr/bin/env python3

from pathlib import Path
import argparse
import os
import numpy as np
from os.path import join
import cv2 as cv
from PIL import Image
from tqdm import tqdm
from glob import glob


def parse():
    parser = argparse.ArgumentParser()
    parser.add_argument('targets', type=str, nargs='+')
    parser.add_argument('--direction', '-d', type=int, choices=[0, 1], default=1)
    return parser.parse_args()


def normalize_to_uint8(img):
    if np.issubdtype(img.dtype, np.integer):
        max_value = np.iinfo(img.dtype).max
        if max_value <= 255:
            return img.astype(np.uint8)
        img = img.astype(np.float32) * (255.0 / max_value)
    elif np.issubdtype(img.dtype, np.floating):
        max_value = 1.0 if img.max() <= 1.0 else 255.0
        img = img.astype(np.float32) * (255.0 / max_value)

    return np.clip(img, 0, 255).astype(np.uint8)


def load_image(path):
    img = cv.imread(path, cv.IMREAD_UNCHANGED)
    if img is None:
        raise FileNotFoundError(path)

    if img.ndim == 2:
        img = cv.cvtColor(img, cv.COLOR_GRAY2RGB)
    elif img.shape[2] == 4:
        img = cv.cvtColor(img, cv.COLOR_BGRA2RGB)
    else:
        img = cv.cvtColor(img, cv.COLOR_BGR2RGB)

    return normalize_to_uint8(img)


def main(args):
    # define output path
    targets = args.targets
    dir_out = '_'.join(targets)
    dir_out = dir_out.replace('/', '_')
    os.makedirs(dir_out, exist_ok=True)

    groups = [sorted(glob(join(target, '*.*'))) for target in targets]
    for group in tqdm(list(zip(*groups))):
        xs = [load_image(path) for path in group]
        x = np.concatenate(xs, axis=args.direction)
        img = Image.fromarray(x)
        names = [Path(path).stem for path in group]
        name = '_'.join(names)
        img.save(join(dir_out, f'{name}.png'))


if __name__ == '__main__':
    args = parse()
    main(args)
